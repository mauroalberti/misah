/.idea
/target
/to_ingest

# CI points CARGO_HOME here, because GitLab caches only what lies inside the
# build directory.
/.cargo

__pycache__/
*.py[cod]

# Compiled extensions. docs/notebooks/mispy.so, 3.4 MB of it, was tracked for
# long enough that it is worth saying outright: these are build output, and
# maturin puts them where the build wants them.
*.so
*.pyd
*.dylib

# Jupyter writes these beside the notebook and they duplicate it wholesale.
.ipynb_checkpoints/

# A GeoProfiler export carries journal_mode=WAL, so merely opening the test
# fixture -- read-only at that -- drops these beside it.
*.gpkg-shm
*.gpkg-wal

# gfortran writes a module file per module into the working directory, so
# compiling the reference sources this crate is ported from -- geoSurfDEM's
# GeoInversions, Alberti (2010)'s GeoFaults -- leaves them here.
*.mod

# Wheels are built into this by the packaging stage.
/wheels/
